{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compass Helper",
  "version": "0.1.0",
  "identifier": "dev.compass.helper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Global-hotkey capture for Compass",
    "longDescription": "A menubar helper that owns a global hotkey for instant capture to your Compass server. Captures queue locally if the network drops and replay automatically.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {}
}
