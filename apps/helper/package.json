{
  "name": "@compass/helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compass menubar helper — global-hotkey instant capture (Tauri 2, macOS first).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
