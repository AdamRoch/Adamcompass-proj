# --- Compass server env ---
NODE_ENV=development

# Database dialect: "sqlite" (default) or "pg"
COMPASS_DB_DIALECT=sqlite

# SQLite path (used when dialect=sqlite)
COMPASS_SQLITE_PATH=./data/compass.db

# Postgres URL (used when dialect=pg)
DATABASE_URL=postgres://compass:compass@localhost:5432/compass

# Session + webhook secrets (use 32+ random chars in prod)
COMPASS_SESSION_SECRET=dev-session-secret-change-me-please-32chars
COMPASS_WEBHOOK_HMAC_SECRET=dev-hmac-secret-change-me-please-32chars

# Per-server pepper mixed into bearer-token hashes; treat like a session secret.
# Rotating this invalidates every existing CLI / helper / webhook token.
COMPASS_TOKEN_PEPPER=dev-token-pepper-change-me-please-32chars

# Gate the "first sign-in creates the user" behaviour on fresh installs. Leave unset in prod
# after the operator account is created.
# COMPASS_BOOTSTRAP_ALLOW_FIRST_USER=1

# Public-facing base URL (used for cookies, links in emails/Telegram)
COMPASS_BASE_URL=http://localhost:3000

# User-local timezone (defaults to America/Chicago to match OpenClaw)
COMPASS_TZ=America/Chicago

# --- Telegram (reuses OpenClaw bot for v1) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Litestream (SQLite path, prod) ---
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
